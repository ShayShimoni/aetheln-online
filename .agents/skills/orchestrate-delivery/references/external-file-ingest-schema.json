{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Case/Unicode path collisions and cross-record path uniqueness are enforced by the runtime validator because JSON Schema cannot express them.",
  "oneOf": [
    { "$ref": "#/$defs/external_file_bundle" },
    { "$ref": "#/$defs/prepared_journal" },
    { "$ref": "#/$defs/accepted_ingest_evidence" }
  ],
  "$defs": {
    "external_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\<>:\"|?*\\u0000-\\u001F])(?!(?:.*\\/)?(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?!.*[. ](?:/|$)).+\\.(?:json|md|png|ps1|svg)$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation", "size", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/external_path" },
        "operation": { "const": "create" },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "inventory_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/external_path" },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "external_file_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "target_root", "files"],
      "properties": {
        "format": { "const": "delivery_external_file_bundle_v1" },
        "target_root": { "const": "visuals" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/file" }
        }
      }
    },
    "prepared_journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "state", "source_commit", "repository_root", "source_root",
        "staging_root", "staged_payload_root", "target_root",
        "destination_root", "external_manifest_sha256",
        "expected_inventory_sha256", "files"
      ],
      "properties": {
        "format": { "const": "delivery_external_file_ingest_journal_v1" },
        "state": { "const": "prepared" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "repository_root": { "type": "string", "minLength": 1 },
        "source_root": { "type": "string", "minLength": 1 },
        "staging_root": { "type": "string", "minLength": 1 },
        "staged_payload_root": { "type": "string", "minLength": 1 },
        "target_root": { "const": "visuals" },
        "destination_root": { "type": "string", "minLength": 1 },
        "external_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/inventory_file" }
        }
      }
    },
    "accepted_ingest_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "disposition", "source_commit", "target_root",
        "destination_root", "external_manifest_sha256",
        "prepared_journal_sha256", "final_inventory_sha256",
        "changed_paths", "files"
      ],
      "properties": {
        "format": { "const": "delivery_external_file_ingest_evidence_v1" },
        "disposition": { "const": "accepted" },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
        "target_root": { "const": "visuals" },
        "destination_root": { "type": "string", "minLength": 1 },
        "external_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "prepared_journal_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "final_inventory_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "changed_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 248,
            "pattern": "^visuals/(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\<>:\"|?*\\u0000-\\u001F])(?!(?:.*\\/)?(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|/|$))(?!.*[. ](?:/|$)).+\\.(?:json|md|png|ps1|svg)$"
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/inventory_file" }
        }
      }
    }
  }
}
