{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "status",
    "summary",
    "evidence",
    "changed_paths",
    "findings",
    "artifact"
  ],
  "properties": {
    "stage": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "files"
      ],
      "properties": {
        "format": {
          "type": "string",
          "const": "delivery_file_bundle_v1"
        },
        "files": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "operation",
              "base_sha256",
              "encoding",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "enum": [
                  "create",
                  "replace"
                ]
              },
              "base_sha256": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "encoding": {
                "type": "string",
                "enum": [
                  "utf8",
                  "base64"
                ]
              },
              "content": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
