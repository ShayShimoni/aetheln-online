{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetheln.invalid/schemas/asset-intake-policy-v2.json",
  "title": "Aetheln Online asset intake policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "lifecycle_states",
    "lifecycle_gates",
    "audiences",
    "provenance",
    "identity",
    "storage",
    "intake_controls",
    "references",
    "thresholds",
    "policy_families",
    "grandfathered_temporary_prototype",
    "report"
  ],
  "properties": {
    "schema_id": { "const": "aetheln.asset-intake-policy" },
    "schema_version": { "const": 2 },
    "lifecycle_states": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["concept_reference", "temporary_prototype", "runtime_candidate", "production_approved"] },
      "minItems": 4,
      "maxItems": 4
    },
    "lifecycle_gates": { "$ref": "#/$defs/lifecycleGates" },
    "audiences": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["shared", "server_only", "client_only"] },
      "minItems": 3,
      "maxItems": 3
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "identity": { "$ref": "#/$defs/identity" },
    "storage": { "$ref": "#/$defs/storage" },
    "intake_controls": { "$ref": "#/$defs/intakeControls" },
    "references": { "$ref": "#/$defs/references" },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "policy_families": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/policyFamily" }
    },
    "grandfathered_temporary_prototype": { "$ref": "#/$defs/grandfather" },
    "report": { "$ref": "#/$defs/report" }
  },
  "$defs": {
    "closedObject": { "type": "object", "additionalProperties": false },
    "lifecycleGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward_transitions",
        "repository_presence_implies_approval",
        "successful_import_implies_approval",
        "successful_cook_implies_approval",
        "evidence_change_returns_to_review",
        "runtime_candidate_requires",
        "production_approval_requires"
      ],
      "properties": {
        "forward_transitions": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/lifecycleTransition" }
        },
        "repository_presence_implies_approval": { "const": false },
        "successful_import_implies_approval": { "const": false },
        "successful_cook_implies_approval": { "const": false },
        "evidence_change_returns_to_review": { "const": true },
        "runtime_candidate_requires": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["complete_provenance", "rights_evidence", "stable_identity_and_version", "audience", "all_deterministic_families_passed", "named_reviewer", "approval_record", "exact_content_identity"] }
        },
        "production_approval_requires": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["exact_runtime_candidate_revision", "production_reviewer", "production_approval_record", "exact_content_identity", "exact_runtime_candidate_approval_record"] }
        }
      }
    },
    "lifecycleTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "enum": ["concept_reference", "temporary_prototype", "runtime_candidate"] },
        "to": { "enum": ["temporary_prototype", "runtime_candidate", "production_approved"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "automation_may_download_or_accept_terms"],
      "properties": {
        "required_fields": { "type": "array", "minItems": 9, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "automation_may_download_or_accept_terms": { "const": false }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_id_required", "positive_content_version_required", "rename_changes_identity", "duplicate_identity_result", "missing_identity_result"],
      "properties": {
        "stable_id_required": { "const": true },
        "positive_content_version_required": { "const": true },
        "rename_changes_identity": { "const": false },
        "duplicate_identity_result": { "const": "fail" },
        "missing_identity_result": { "const": "fail" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_root", "runtime_root", "repository_presence_implies_approval"],
      "properties": {
        "source_root": { "const": "SourceAssets/" },
        "runtime_root": { "const": "Content/" },
        "repository_presence_implies_approval": { "const": false }
      }
    },
    "intakeControls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_assets_may_be_cooked",
        "runtime_assets_require_intake_record",
        "naming_owner_required",
        "import_settings_required",
        "reimport_settings_required",
        "lfs_policy_path",
        "lock_before_binary_edit",
        "recovery_requires_preserved_copy"
      ],
      "properties": {
        "source_assets_may_be_cooked": { "const": false },
        "runtime_assets_require_intake_record": { "const": true },
        "naming_owner_required": { "const": true },
        "import_settings_required": { "const": true },
        "reimport_settings_required": { "const": true },
        "lfs_policy_path": { "const": "docs/source-control.md" },
        "lock_before_binary_edit": { "const": true },
        "recovery_requires_preserved_copy": { "const": true }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "soft_presentation_requires_declared_rule",
        "soft_reference_rules",
        "candidate_redirectors_allowed",
        "broken_references_allowed",
        "editor_only_runtime_dependency_allowed",
        "incompatible_content_version_result",
        "hard_reference_exceptions",
        "hard_reference_audience_rules"
      ],
      "properties": {
        "soft_presentation_requires_declared_rule": { "const": true },
        "soft_reference_rules": { "$ref": "#/$defs/softReferenceRules" },
        "candidate_redirectors_allowed": { "const": false },
        "broken_references_allowed": { "const": false },
        "editor_only_runtime_dependency_allowed": { "const": false },
        "incompatible_content_version_result": { "const": "fail" },
        "hard_reference_exceptions": { "$ref": "#/$defs/hardReferenceExceptions" },
        "hard_reference_audience_rules": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/hardReferenceAudienceRule" }
        }
      }
    },
    "softReferenceRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_allowed", "match_mode", "required_fields", "rules"],
      "properties": {
        "default_allowed": { "const": false },
        "match_mode": { "const": "full_package_path_and_audience" },
        "required_fields": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["id", "source_package_pattern", "source_audience", "target_package_pattern", "target_audience", "justification"] }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/softReferenceRule" }
        }
      }
    },
    "softReferenceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_package_pattern", "source_audience", "target_package_pattern", "target_audience", "justification"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "source_package_pattern": { "type": "string", "pattern": "^\\^/Game.*\\$$" },
        "source_audience": { "enum": ["shared", "server_only", "client_only"] },
        "target_package_pattern": { "type": "string", "pattern": "^\\^/Game.*\\$$" },
        "target_audience": { "enum": ["shared", "server_only", "client_only"] },
        "justification": { "type": "string", "minLength": 1 }
      }
    },
    "hardReferenceExceptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_allowed", "required_fields"],
      "properties": {
        "default_allowed": { "const": false },
        "required_fields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["owner", "justification", "source_audience", "target_audience", "reviewer", "approval_record", "revisit_trigger"] }
        }
      }
    },
    "hardReferenceAudienceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "may_reference"],
      "properties": {
        "source": { "enum": ["shared", "server_only", "client_only"] },
        "may_reference": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["shared", "server_only", "client_only"] }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unresolved_value", "tbd_requires_owner", "tbd_requires_revisit_trigger", "tbd_may_promote_to_production", "unresolved_budgets"],
      "properties": {
        "unresolved_value": { "const": "TBD" },
        "tbd_requires_owner": { "const": true },
        "tbd_requires_revisit_trigger": { "const": true },
        "tbd_may_promote_to_production": { "const": false },
        "unresolved_budgets": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/unresolvedBudget" }
        }
      }
    },
    "unresolvedBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "owner", "revisit_trigger"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "value": { "const": "TBD" },
        "owner": { "type": "string", "minLength": 1 },
        "revisit_trigger": { "type": "string", "minLength": 1 }
      }
    },
    "policyFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "applicability_required", "deterministic_invariants_fail", "unresolved_quantitative_result", "failure_code", "checks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "applicability_required": { "const": true },
        "deterministic_invariants_fail": { "const": true },
        "unresolved_quantitative_result": { "const": "non_promotion" },
        "failure_code": { "type": "string", "pattern": "^content\\.[a-z0-9_]+\\.failed$" },
        "checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    },
    "grandfather": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "requires_owner", "requires_recovery_trigger", "may_be_runtime_candidate"],
      "properties": {
        "allowed": { "const": true },
        "requires_owner": { "const": true },
        "requires_recovery_trigger": { "const": true },
        "may_be_runtime_candidate": { "const": false }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "required_fields",
        "finding_required_fields",
        "asset_required_fields",
        "provenance_required_fields",
        "lifecycle_evidence_required_fields",
        "execution_provenance_required_fields",
        "family_result_required_fields",
        "check_result_required_fields",
        "artifact_descriptor_required_fields",
        "loaded_project_module_required_fields",
        "loaded_project_module_names",
        "counts_required_fields",
        "allowed_results",
        "allowed_deterministic_statuses",
        "allowed_promotion_statuses",
        "allowed_severities",
        "allowed_registry_sources"
      ],
      "properties": {
        "schema_id": { "const": "aetheln.content-validation-report" },
        "schema_version": { "const": 2 },
        "required_fields": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": { "enum": ["schema_id", "schema_version", "revision", "engine_identity", "policy_sha256", "intake_sha256", "execution_provenance", "audience", "started_utc", "finished_utc", "command", "counts", "assets", "findings", "result"] }
        },
        "finding_required_fields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "enum": ["policy_id", "code", "asset_path", "severity", "reason", "remediation", "evidence_field"] }
        },
        "asset_required_fields": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["asset_path", "stable_id", "content_version", "audience", "lifecycle_state", "provenance", "lifecycle_evidence", "family_results"] }
        },
        "provenance_required_fields": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": { "enum": ["author_or_provider", "source_record", "source_version", "license_or_permission_evidence", "modifications", "generation_metadata_when_applicable", "content_sha256", "reviewer", "approval_state"] }
        },
        "lifecycle_evidence_required_fields": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["content_identity", "temporary_prototype", "runtime_candidate", "production_approval"] }
        },
        "execution_provenance_required_fields": {
          "type": "array",
          "minItems": 22,
          "maxItems": 22,
          "uniqueItems": true,
          "items": { "enum": ["repository_clean", "engine_revision", "engine_tag", "engine_binary_sha256", "build_version_sha256", "target", "platform", "configuration", "editor_build_command_sha256", "editor_build_log_sha256", "compiler_version", "compiler_sha256", "resource_compiler_version", "resource_compiler_sha256", "target_receipt", "module_manifest", "loaded_project_modules", "project_sha256", "policy_sha256", "intake_sha256", "invocation_sha256", "registry_source"] }
        },
        "family_result_required_fields": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "enum": ["policy_id", "applicability", "deterministic_status", "promotion_status", "evidence", "check_results"] }
        },
        "check_result_required_fields": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["check_id", "applicability", "deterministic_status", "promotion_status", "evidence"] }
        },
        "artifact_descriptor_required_fields": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["path", "size_bytes", "sha256", "build_id"] }
        },
        "loaded_project_module_required_fields": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["name", "path", "size_bytes", "sha256", "build_id"] }
        },
        "loaded_project_module_names": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["GameCore", "GameTests"] }
        },
        "counts_required_fields": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["assets", "findings", "errors", "non_promotion"] }
        },
        "allowed_results": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["passed", "failed", "non_promotion"] }
        },
        "allowed_deterministic_statuses": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["passed", "failed", "evidence_unavailable", "not_applicable"] }
        },
        "allowed_promotion_statuses": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["eligible", "non_promotion", "not_applicable"] }
        },
        "allowed_severities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["error", "non_promotion"] }
        },
        "allowed_registry_sources": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["live_asset_registry", "test_snapshot"] }
        }
      }
    }
  }
}
